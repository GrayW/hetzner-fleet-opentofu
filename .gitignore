# OpenTofu / Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan

# Sensitive variable files (keep the example)
*.tfvars
!*.tfvars.example
*.auto.tfvars
*.auto.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated SSH private key (written by OpenTofu next to the config)
.fleet_ed25519
