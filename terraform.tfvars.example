# Copy to terraform.tfvars and fill in values.
# terraform.tfvars is gitignored — never commit secrets.

# Required
hetzner_token = "your-hetzner-api-token"

# Also required: state_passphrase (encrypts the state). Don't put it here;
# export it from your password manager instead:
#   export TF_VAR_state_passphrase="$(op read op://vault/fleet-tofu/passphrase)"

# SSH access — restrict to your own IP(s) for security
# admin_cidrs = ["203.0.113.5/32"]        # Single IPv4
# admin_cidrs = ["0.0.0.0/0", "::/0"]    # Open to all (lab use only)

# Optional overrides (defaults shown)
# server_type       = "cpx22"
# location          = "nbg1"              # nbg1=Nuremberg, fsn1=Falkenstein, hel1=Helsinki
# image_name        = "opensuse-16"
# fleet_version     = "v4.87.1"           # Pin Fleet — never use 'latest' (tracks dev builds)
# fleet_license_key = "your-license-key"  # Leave empty for Community Edition
# domain            = "fleet.example.com"
# admin_email       = "admin@example.com"
# protect_resources = true                # Set false, apply, then destroy to tear down
# server_backups    = false               # Hetzner daily server-disk backups, ~+20% server cost

# Object Storage — leave empty to skip (can add later with tofu apply)
# S3 region is derived from var.location automatically (Hetzner requirement).
# s3_access_key = "your-hetzner-s3-access-key"
# s3_secret_key = "your-hetzner-s3-secret-key"

# Off-host backups (restic) — strongly recommended. Use a bucket in a
# different location from the server. Pass the secrets as TF_VAR_* env vars.
# backup_repository      = "s3:https://hel1.your-objectstorage.com/my-fleet-backups/fleet"
# backup_healthcheck_url = "https://hc-ping.com/<uuid>"
#   export TF_VAR_backup_password=… TF_VAR_backup_access_key=… TF_VAR_backup_secret_key=…
